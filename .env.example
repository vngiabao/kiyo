# Leave blank for local-only learning. Use a LOCAL Supabase instance for testing.
# Never put a service-role/secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: comma-separated providers already enabled in Supabase, e.g. google,apple.
VITE_AUTH_PROVIDERS=
# Hosted private deployment uses google-only; local tests may leave blank.
VITE_AUTH_MODE=
