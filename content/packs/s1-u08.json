  "grammar": [
    {
      "id": "s1-u08-g-qing",
      "pattern": "请 + verb · 别 + verb",
      "purpose": "Invite politely, or tell someone not to",
      "explanation": "请 before a verb is a warm invitation: 请进, 请坐, 请喝茶. 别 before a verb means \"don't\": 别客气 (don't stand on ceremony), 别打车. Hosts use both constantly.",
      "examples": [
        { "zh": "请进！请坐！", "py": "Qǐng jìn! Qǐng zuò!", "en": "Come in! Sit down!" },
        { "zh": "别客气，这是你的家！", "py": "Bié kèqi, zhè shì nǐ de jiā!", "en": "Make yourself at home!" },
        { "zh": "请喝茶。", "py": "Qǐng hē chá.", "en": "Please have some tea." }
      ],
      "commonMistakes": [{ "wrong": "不客气，这是你的家！", "right": "别客气，这是你的家！", "why": "不客气 answers thanks; 别客气 tells a guest to relax." }],
      "register": "polite"
    },
    {
      "id": "s1-u08-g-zaishang",
      "pattern": "thing + 在 + place + 上",
      "purpose": "Say where something is",
      "explanation": "在 + place + a position word: 桌子上 (on the table), 左边 (on the left). The thing comes first: 水果在桌子上.",
      "examples": [
        { "zh": "水果在桌子上。", "py": "Shuǐguǒ zài zhuōzi shang.", "en": "The fruit is on the table." },
        { "zh": "你的房间在左边。", "py": "Nǐ de fángjiān zài zuǒbian.", "en": "Your room is on the left." }
      ],
      "register": "neutral"
    }
  ],
  "dialogue": {
    "id": "s1-u08-d",
    "title": "Dropping by",
    "titleZh": "欢迎",
    "setting": "Chen Yu visits Lin An's new flat for the first time.",
    "register": "casual",
    "speakers": [{ "id": "linan", "name": "林安" }, { "id": "chenyu", "name": "陈宇" }],
    "glosses": [{ "hanzi": "哪里", "pinyin": "nǎli", "meaning": "\"not at all\" (a modest reply to praise)" }],
    "lines": [
      { "speaker": "linan", "zh": "欢迎，欢迎！请进！", "py": "Huānyíng, huānyíng! Qǐng jìn!", "en": "Welcome! Come in!" },
      { "speaker": "chenyu", "zh": "这是给你的水果。", "py": "Zhè shì gěi nǐ de shuǐguǒ.", "en": "I brought you some fruit." },
      { "speaker": "linan", "zh": "你太客气了！请坐，喝点儿茶吧。", "py": "Nǐ tài kèqi le! Qǐng zuò, hē diǎnr chá ba.", "en": "You shouldn't have! Sit down, have some tea." },
      { "speaker": "chenyu", "zh": "谢谢！你的房子真漂亮。", "py": "Xièxie! Nǐ de fángzi zhēn piàoliang.", "en": "Thanks! Your place is lovely." },
      { "speaker": "linan", "zh": "哪里，房子很小。", "py": "Nǎli, fángzi hěn xiǎo.", "en": "Oh, it's tiny." },
      { "speaker": "chenyu", "zh": "很晚了，我走了。", "py": "Hěn wǎn le, wǒ zǒu le.", "en": "It's late. I'd better go." },
      { "speaker": "linan", "zh": "再坐一会儿吧！", "py": "Zài zuò yíhuìr ba!", "en": "Stay a bit longer!" },
      { "speaker": "chenyu", "zh": "不了，谢谢你的茶！", "py": "Bù le, xièxie nǐ de chá!", "en": "No, really. Thanks for the tea!" },
      { "speaker": "linan", "zh": "不客气，慢走！", "py": "Bú kèqi, màn zǒu!", "en": "You're welcome. Take care!" }
    ],
    "questions": [
