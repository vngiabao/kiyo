  "grammar": [
    {
      "id": "s1-u03-g-tai",
      "pattern": "太 + adjective + 了 · 很 / 非常 + adjective",
      "purpose": "Describe how hot, cold or nice it is",
      "explanation": "Adjectives work as verbs, so no 是: 今天很冷. Bare 很 is mild; 非常 is \"very\"; 太…了 is \"so…!\" or \"too…\", a reaction. Don't drop 了 from 太…了 in speech.",
      "examples": [
        { "zh": "今天很冷。", "py": "Jīntiān hěn lěng.", "en": "It's cold today." },
        { "zh": "北京今天非常冷。", "py": "Běijīng jīntiān fēicháng lěng.", "en": "Beijing is really cold today." },
        { "zh": "太热了！", "py": "Tài rè le!", "en": "It's so hot!" }
      ],
      "commonMistakes": [{ "wrong": "今天是冷。", "right": "今天很冷。", "why": "Adjectives don't take 是." }],
      "register": "neutral"
    },
    {
      "id": "s1-u03-g-zenmeyang",
      "pattern": "… 怎么样？",
      "purpose": "Ask how something is, or what someone thinks",
      "explanation": "Put 怎么样 at the end to ask about a state or an opinion: 天气怎么样？ (What's the weather like?) 这个蛋糕怎么样？ (How's the cake?) After a suggestion it means \"how about it?\".",
      "examples": [
        { "zh": "今天天气怎么样？", "py": "Jīntiān tiānqì zěnmeyàng?", "en": "How's the weather today?" },
        { "zh": "这个蛋糕怎么样？", "py": "Zhège dàngāo zěnmeyàng?", "en": "How's the cake?" },
        { "zh": "我们中午一起吃饭，怎么样？", "py": "Wǒmen zhōngwǔ yìqǐ chīfàn, zěnmeyàng?", "en": "Lunch together, how about it?" }
      ],
      "register": "neutral"
    }
  ],
  "dialogue": {
    "id": "s1-u03-d",
    "title": "A cold morning",
    "titleZh": "今天好冷",
    "setting": "Lin An and Chen Yu bump into each other outside the flats.",
    "register": "casual",
    "speakers": [{ "id": "linan", "name": "林安" }, { "id": "chenyu", "name": "陈宇" }],
    "lines": [
      { "speaker": "linan", "zh": "早上好！今天天气怎么样？", "py": "Zǎoshang hǎo! Jīntiān tiānqì zěnmeyàng?", "en": "Morning! How's the weather today?" },
      { "speaker": "chenyu", "zh": "太冷了！外边风很大。", "py": "Tài lěng le! Wàibian fēng hěn dà.", "en": "Freezing! It's really windy." },
      { "speaker": "linan", "zh": "下雨吗？", "py": "Xià yǔ ma?", "en": "Is it raining?" },
      { "speaker": "chenyu", "zh": "早上不下，下午下雨。", "py": "Zǎoshang bú xià, xiàwǔ xià yǔ.", "en": "Not this morning. It'll rain this afternoon." },
      { "speaker": "linan", "zh": "好，我多穿一点儿衣服。", "py": "Hǎo, wǒ duō chuān yìdiǎnr yīfu.", "en": "OK, I'll put on another layer." },
      { "speaker": "chenyu", "zh": "中午我们一起吃饭，怎么样？", "py": "Zhōngwǔ wǒmen yìqǐ chīfàn, zěnmeyàng?", "en": "Lunch together, how about it?" },
      { "speaker": "linan", "zh": "好啊。外边太冷，我们在家吃吧！", "py": "Hǎo a. Wàibian tài lěng, wǒmen zài jiā chī ba!", "en": "Sure. It's too cold out; let's eat at home!" }
    ],
