  "grammar": [
    {
      "id": "s1-u09-g-le",
      "pattern": "situation + 了 (something has changed)",
      "purpose": "Say a new situation has started",
      "explanation": "了 at the end can mean \"now it's like this\": 我病了 (I've got ill), 我好点儿了 (I'm better now), 很晚了 (it's got late). It marks a change, not just the past.",
      "examples": [
        { "zh": "我病了。", "py": "Wǒ bìng le.", "en": "I'm ill (now)." },
        { "zh": "我好点儿了。", "py": "Wǒ hǎo diǎnr le.", "en": "I'm a bit better." },
        { "zh": "我感冒了。", "py": "Wǒ gǎnmào le.", "en": "I've caught a cold." }
      ],
      "register": "neutral"
    },
    {
      "id": "s1-u09-g-duo",
      "pattern": "多 + verb",
      "purpose": "Give caring advice",
      "explanation": "多 before a verb means \"do more of it\": 多喝水 (drink plenty of water), 多休息 (get lots of rest). It's what everyone says to someone who's ill.",
      "examples": [
        { "zh": "多喝水，多休息。", "py": "Duō hē shuǐ, duō xiūxi.", "en": "Drink lots of water and rest." },
        { "zh": "你要多睡觉。", "py": "Nǐ yào duō shuìjiào.", "en": "You need more sleep." }
      ],
      "register": "casual"
    }
  ],
  "dialogue": {
    "id": "s1-u09-d",
    "title": "A phone call",
    "titleZh": "你怎么了",
    "setting": "Anna missed class. Lin An calls to check on her.",
    "register": "casual",
    "speakers": [{ "id": "linan", "name": "林安" }, { "id": "anna", "name": "安娜" }],
    "lines": [
      { "speaker": "linan", "zh": "喂，安娜，你怎么了？", "py": "Wéi, Ānnà, nǐ zěnme le?", "en": "Hi Anna, what's wrong?" },
      { "speaker": "anna", "zh": "我病了，头很疼。", "py": "Wǒ bìng le, tóu hěn téng.", "en": "I'm ill. I've got a bad headache." },
      { "speaker": "linan", "zh": "你感冒了吧？你要去医院看病吗？", "py": "Nǐ gǎnmào le ba? Nǐ yào qù yīyuàn kànbìng ma?", "en": "A cold? Are you going to see a doctor?" },
      { "speaker": "anna", "zh": "不用，我有药。", "py": "Bú yòng, wǒ yǒu yào.", "en": "No need, I have medicine." },
      { "speaker": "linan", "zh": "那你多喝水，多休息。", "py": "Nà nǐ duō hē shuǐ, duō xiūxi.", "en": "Then drink lots of water and rest." },
      { "speaker": "anna", "zh": "好，我想睡觉。", "py": "Hǎo, wǒ xiǎng shuìjiào.", "en": "OK. I want to sleep." },
      { "speaker": "linan", "zh": "明天我去看你，给你买水果。", "py": "Míngtiān wǒ qù kàn nǐ, gěi nǐ mǎi shuǐguǒ.", "en": "I'll come and see you tomorrow and bring fruit." },
      { "speaker": "anna", "zh": "谢谢你！", "py": "Xièxie nǐ!", "en": "Thank you!" }
    ],
    "questions": [
      { "type": "gist", "q": "Why is Lin An calling?", "choices": ["Anna is ill", "Anna's birthday", "To plan a trip"], "answer": "Anna is ill" },
      { "type": "detail", "q": "What hurts?", "choices": ["Her head", "Her back", "Nothing, she's tired"], "answer": "Her head" },
      { "type": "intent", "q": "What does Lin An offer to do?", "choices": ["Visit tomorrow with fruit", "Take her to hospital now", "Call a doctor"], "answer": "Visit tomorrow with fruit" }
    ]
  },
