      { "zh": "星期四我去上课。", "py": "Xīngqīsì wǒ qù shàngkè.", "en": "I'll be back in class on Thursday." },
      { "zh": "谢谢您！安娜", "py": "Xièxie nín! Ānnà", "en": "Thank you! Anna" }
