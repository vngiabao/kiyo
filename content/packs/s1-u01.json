  "grammar": [
    {
      "id": "s1-u01-g-sui",
      "pattern": "Person + (今年) + number + 岁",
      "purpose": "Say how old someone is",
      "explanation": "Age needs no verb: 我二十五岁 (\"I twenty-five years\"). 今年 (this year) often comes first. Ask a peer 你多大？, a child 你几岁？, and an elder 您多大年纪了？.",
      "examples": [
        { "zh": "我今年二十五岁。", "py": "Wǒ jīnnián èrshíwǔ suì.", "en": "I'm twenty-five this year." },
        { "zh": "你今年多大？", "py": "Nǐ jīnnián duō dà?", "en": "How old are you this year?" },
        { "zh": "她三岁。", "py": "Tā sān suì.", "en": "She's three." }
      ],
      "commonMistakes": [{ "wrong": "我是二十五岁。", "right": "我二十五岁。", "why": "Age usually drops 是." }],
      "register": "neutral"
    },
    {
      "id": "s1-u01-g-date",
      "pattern": "X 月 X 号 + 星期 X",
      "purpose": "Give a date and a day of the week",
      "explanation": "Chinese goes from big to small: month, then day, then weekday. Days are numbers too: 星期一 is Monday, 星期六 Saturday; Sunday is 星期天. Ask with 几: 几月几号？ 星期几？",
      "examples": [
        { "zh": "今天三月八号，星期六。", "py": "Jīntiān sān yuè bā hào, xīngqīliù.", "en": "Today is Saturday, March 8th." },
        { "zh": "你的生日是几月几号？", "py": "Nǐ de shēngrì shì jǐ yuè jǐ hào?", "en": "When is your birthday?" },
        { "zh": "明天星期几？", "py": "Míngtiān xīngqī jǐ?", "en": "What day is it tomorrow?" }
      ],
      "commonMistakes": [{ "wrong": "八号三月", "right": "三月八号", "why": "Month comes before day." }],
      "register": "neutral"
    }
  ],
