      "example": { "zh": "两个蛋糕五十块。", "py": "Liǎng ge dàngāo wǔshí kuài.", "en": "Two cakes for fifty." }, "usageNote": "Counting things: 两个, 两块. Saying the number itself: 二 (二十, 十二)." },
    { "id": "s1-u06-w-gui", "hanzi": "贵", "pinyin": "guì", "pos": "adjective", "meaning": "expensive", "meaningVi": "đắt", "register": "neutral", "hskLevel": 1,
