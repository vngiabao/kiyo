      "example": { "zh": "老板，这个多少钱？", "py": "Lǎobǎn, zhège duōshao qián?", "en": "Excuse me, how much is this?" }, "usageNote": "The friendly way to call any stallholder or small-shop owner." }
  ],
  "grammar": [
    {
      "id": "s1-u06-g-money",
      "pattern": "number + 块 · 两 + measure word",
      "purpose": "Say and understand prices",
      "explanation": "Say prices with 块: 三十块, 一百二十块. Before any measure word, two is 两: 两个, 两块, 两件. 二 is for the number itself (二十, 十二). 多少钱 asks the price.",
      "examples": [
        { "zh": "这件衣服一百二十块。", "py": "Zhè jiàn yīfu yìbǎi èrshí kuài.", "en": "This top is 120 yuan." },
        { "zh": "两个蛋糕五十块。", "py": "Liǎng ge dàngāo wǔshí kuài.", "en": "Two cakes for 50." },
        { "zh": "水三块。", "py": "Shuǐ sān kuài.", "en": "Water is 3 yuan." }
      ],
      "commonMistakes": [{ "wrong": "二个蛋糕", "right": "两个蛋糕", "why": "Use 两 before a measure word." }],
      "register": "neutral"
    },
    {
      "id": "s1-u06-g-bargain",
      "pattern": "adjective + 一点儿 + 吧",
      "purpose": "Ask for a little more or less, politely",
      "explanation": "一点儿 after an adjective means \"a bit more so\": 便宜一点儿 (a bit cheaper), 慢一点儿 (a bit slower). 吧 turns it into a soft request.",
      "examples": [
        { "zh": "便宜一点儿吧！", "py": "Piányi yìdiǎnr ba!", "en": "A bit cheaper?" },
        { "zh": "慢一点儿吧。", "py": "Màn yìdiǎnr ba.", "en": "A bit slower, please." }
      ],
      "register": "casual"
    }
  ],
  "dialogue": {
    "id": "s1-u06-d",
    "title": "At the night market",
    "titleZh": "多少钱",
    "setting": "Lin An likes a top at a market stall.",
    "register": "casual",
    "speakers": [{ "id": "linan", "name": "林安" }, { "id": "boss", "name": "老板" }],
    "lines": [
      { "speaker": "linan", "zh": "老板，这件衣服多少钱？", "py": "Lǎobǎn, zhè jiàn yīfu duōshao qián?", "en": "How much is this top?" },
      { "speaker": "boss", "zh": "一百二十块。", "py": "Yìbǎi èrshí kuài.", "en": "120." },
      { "speaker": "linan", "zh": "太贵了！便宜一点儿吧。", "py": "Tài guì le! Piányi yìdiǎnr ba.", "en": "Too expensive! A bit cheaper?" },
      { "speaker": "boss", "zh": "一百块，怎么样？", "py": "Yìbǎi kuài, zěnmeyàng?", "en": "100, how's that?" },
      { "speaker": "linan", "zh": "八十块，可以吗？", "py": "Bāshí kuài, kěyǐ ma?", "en": "Would 80 work?" },
      { "speaker": "boss", "zh": "好吧，八十块。你试试？", "py": "Hǎo ba, bāshí kuài. Nǐ shìshi?", "en": "Fine, 80. Want to try it on?" },
      { "speaker": "linan", "zh": "好看！我要了。", "py": "Hǎokàn! Wǒ yào le.", "en": "It looks good! I'll take it." },
      { "speaker": "boss", "zh": "还要别的吗？", "py": "Hái yào biéde ma?", "en": "Anything else?" },
      { "speaker": "linan", "zh": "不要了，谢谢！", "py": "Bú yào le, xièxie!", "en": "That's all, thanks!" }
    ],
    "questions": [
      { "type": "gist", "q": "What is Lin An buying?", "choices": ["A top", "A cake", "A phone"], "answer": "A top" },
      { "type": "detail", "q": "What price do they agree on?", "choices": ["80 yuan", "100 yuan", "120 yuan"], "answer": "80 yuan" },
      { "type": "intent", "q": "What does the stall owner mean by 还要别的吗？", "choices": ["Do you want anything else?", "Is it too expensive?", "Do you want to try it on?"], "answer": "Do you want anything else?" }
    ]
  },
