    { "id": "s1-u06-w-jian", "hanzi": "件", "pinyin": "jiàn", "pos": "measure word", "meaning": "measure word for clothes (tops)", "meaningVi": "chiếc (áo)", "register": "neutral", "hskLevel": null,
      "example": { "zh": "这件衣服多少钱？", "py": "Zhè jiàn yīfu duōshao qián?", "en": "How much is this top?" } },
