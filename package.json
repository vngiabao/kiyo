{
  "name": "tingjian",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsx scripts/build-packs.ts && tsx scripts/check-pinyin.ts && tsx scripts/check-contextual-pinyin.ts && tsx scripts/copy-stroke-data.ts && tsx scripts/check-audio.ts && tsx scripts/make-brand.ts && tsc -b && vite build",
    "postbuild": "tsx scripts/check-installed-data.ts && tsx scripts/pack-deployment-audio.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "validate:content": "tsx scripts/validate-content.ts && tsx scripts/check-contextual-pinyin.ts && tsx scripts/check-audio.ts",
    "audio:manifest": "tsx scripts/audio-manifest.ts",
    "audio:check": "tsx scripts/check-audio.ts",
    "test:e2e": "playwright test",
    "pretest:e2e": "tsx scripts/voice-task-review.ts",
    "format": "prettier --write src tests e2e scripts/*.ts *.ts index.html",
    "hanzi": "tsx scripts/copy-stroke-data.ts",
    "packs": "tsx scripts/build-packs.ts && tsx scripts/check-pinyin.ts && tsx scripts/check-contextual-pinyin.ts && tsx scripts/copy-stroke-data.ts",
    "check:pinyin": "tsx scripts/check-pinyin.ts && tsx scripts/check-contextual-pinyin.ts",
    "dict": "tsx scripts/build-dictionary.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.117.2",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data": "^2.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
