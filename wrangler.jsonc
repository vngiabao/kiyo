{
  "name": "kiyo",
  "main": "./workers/index.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "kiyo.gbaonvo.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./.deploy-dist",
    "binding": "ASSETS",
    "run_worker_first": ["/audio-v2/*", "/api/*"],
    "not_found_handling": "single-page-application"
  },
  // Sayo's daily note: one cron, every 15 minutes (free plan). Device subscriptions
  // live in KV. The VAPID private key is the secret VAPID_PRIVATE_JWK
  // (wrangler secret put); the public half below is meant to be public.
  "triggers": { "crons": ["*/15 * * * *"] },
  "kv_namespaces": [{ "binding": "PUSH", "id": "4625bbf0f55449df99b19b48362242d2" }],
  "vars": { "VAPID_PUBLIC": "BNfzwyIPFidNQJNOYaEhdtOoNfqyaeDMPSN24yVElJ8IRCqs_w0BO8fc5RUXP3rms10Bwt-ifE2d6tTcDzdrMCc" }
}
